{
  "name": "evenkeel-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An MCP server that exposes EvenKeel's expense data and normalization engine as MCP tools, resources, and prompts for any MCP-capable AI.",
  "bin": {
    "evenkeel-mcp": "src/server.ts"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "gen:sample": "tsx scripts/generate-sample.ts",
    "demo": "tsx scripts/demo-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "date-fns": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
